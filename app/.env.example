# Copy to .env for local runs. Never commit real keys.
# API_KEY_JEV is read from the environment (a user-level env var is fine).

# jev | mock
SIGNAL_MODE=jev
BIND_ADDR=127.0.0.1:8080
# PUBLIC_BASE_URL=http://127.0.0.1:8080
POLICY_PATH=policy.yaml
# Pinned on purpose; aliases such as jev-latest can change decisions.
JEV_MODEL=jev-1.14.0
JEV_BASE_URL=https://api.typesafe.ai
JEV_TIMEOUT_MS=5000
RUST_LOG=info
